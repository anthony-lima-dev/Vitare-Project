# ─── Banco de dados ─────────────────────────────────────────────────────
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable&connection_limit=10&connect_timeout=0&max_idle_connection_lifetime=0&pool_timeout=0&socket_timeout=0"
DIRECT_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# Conexão do runtime (pooler). Quando ausente, cai para DATABASE_URL.
POOLED_DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1"

# ─── Autenticação ────────────────────────────────────────────────────────
# Segredos FICTÍCIOS — gere valores reais fortes em produção (openssl rand -hex 32).
JWT_ACCESS_SECRET="troque-este-segredo-jwt-de-exemplo"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
STAFF_JWT_SECRET="troque-este-segredo-staff-de-exemplo"
STAFF_JWT_EXPIRES_IN="2h"
# Custo bcrypt (10-15). Meça no ambiente-alvo antes de ajustar.
BCRYPT_SALT_ROUNDS="12"
# Política de senha flexível: tamanho mínimo e critérios mínimos (1-4) de
# complexidade (minúscula, maiúscula, dígito, caractere especial). Se ausentes,
# valem os fallbacks seguros: 8 caracteres e 2 critérios.
PASSWORD_MIN_LENGTH="8"
PASSWORD_MIN_RULES="2"
# Chave de bootstrap da PRIMEIRA conta de staff; sem ela, o endpoint
# público de registro de profissionais permanece bloqueado.
STAFF_BOOTSTRAP_KEY="defina-uma-chave-longa-e-aleatoria"

# ─── Google OAuth ────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID="seu-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-exemplo"
GOOGLE_CALLBACK_URL="http://localhost:3000/api/v1/auth/google/callback"

# ─── E-mail ──────────────────────────────────────────────────────────────
RESEND_API_KEY="re_exemplo"
MAIL_FROM="Vitare <noreply@example.com>"

# ─── Aplicação ───────────────────────────────────────────────────────────
PORT="3000"
NODE_ENV="development"
APP_URL="http://localhost:5173"
CORS_ORIGIN="http://localhost:5173"

# ─── Redis (opcional) ────────────────────────────────────────────────────
# Quando vazio/ausente, o adaptador opera em modo desabilitado e as
# consultas de referência fazem fallback ao PostgreSQL (modo degradado).
REDIS_URL="redis://localhost:6379"
REDIS_KEY_PREFIX="vitare:local"
STAFF_GEO_KEY="geo:staff"
STAFF_GEO_TTL_SECONDS="300"
EMERGENCY_IDEMPOTENCY_TTL_HOURS="24"
EMERGENCY_SEARCH_RADIUS_M="5000"


# ─── Documentos jurídicos no onboarding (T-11) ───────────────────────────
# Versão vigente e hash do conteúdo (SHA-256 do texto publicado) de cada
# documento exigido no cadastro/ativação. Alterar a versão obriga re-aceite;
# aceitações de versões anteriores são preservadas (append-only).
TERMS_OF_USE_VERSION="v1.0.0"
TERMS_OF_USE_CONTENT_HASH="sha256:terms-of-use-v1-0-0"
PRIVACY_NOTICE_VERSION="v1.0.0"
PRIVACY_NOTICE_CONTENT_HASH="sha256:privacy-notice-v1-0-0"

# ─── Criptografia de PII (T-08) ──────────────────────────────────────────
# Chaves separadas de 32 bytes (base64). Gere em produção com:
#   openssl rand -base64 32
# NUNCA commite chaves reais. Valores abaixo são apenas placeholders.
ENCRYPTION_KEY="cole-aqui-uma-base64-de-32-bytes"
BLINDED_INDEX_KEY="cole-aqui-uma-base64-de-32-bytes-diferente"
