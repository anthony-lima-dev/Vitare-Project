# Production public stack for https://vitare.app.br
# Copy to .env.public and replace every placeholder.
# Do not commit .env.public.

# Public same-origin API. Vite embeds this value during image build.
VITE_API_URL=/api/v1

# PostgreSQL
POSTGRES_DB=vitare
POSTGRES_USER=vitare
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql://vitare:CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD@db:5432/vitare?schema=public
DIRECT_URL=postgresql://vitare:CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD@db:5432/vitare?schema=public
POOLED_DATABASE_URL=postgresql://vitare:CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD@db:5432/vitare?schema=public

# Public origin / CORS / OAuth
APP_URL=https://vitare.<your_domain_name>
CORS_ORIGIN=https://vitare.<your_domain_name>
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
GOOGLE_CALLBACK_URL=https://vitare<your_domain_name>/api/v1/auth/google/callback

# Cloudflare Tunnel
# Obter em: Cloudflare Zero Trust → Networks → Tunnels → Configure → Token
TUNNEL_TOKEN=REPLACE_WITH_CLOUDFLARE_TUNNEL_TOKEN

# JWT / staff
JWT_ACCESS_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_ACCESS_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
STAFF_JWT_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_STAFF_SECRET
STAFF_JWT_EXPIRES_IN=8h

# Mail
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
MAIL_FROM="Vitare <onboarding@resend.dev>"

NODE_ENV=production
PORT=3000

# Redis interno (rede `data` é interna — não exposta à internet)
REDIS_URL=redis://vitare-public-redis:6379
REDIS_KEY_PREFIX=vitare:public
STAFF_GEO_KEY=geo:staff
STAFF_GEO_TTL_SECONDS=300
EMERGENCY_IDEMPOTENCY_TTL_HOURS=24
EMERGENCY_SEARCH_RADIUS_M=5000

# Bootstrap da PRIMEIRA conta de staff.
STAFF_BOOTSTRAP_KEY=CHANGE_ME_BOOTSTRAP_KEY

# Custo bcrypt (10-15) — meça no ambiente antes de ajustar.
BCRYPT_SALT_ROUNDS=12

# Chaves de criptografia PII (T-08) — 32 bytes cada, base64.
# Gerar com: openssl rand -base64 32
ENCRYPTION_KEY=CHANGE_ME_WITH_BASE64_32_BYTE_KEY
BLINDED_INDEX_KEY=CHANGE_ME_WITH_BASE64_32_BYTE_KEY
ENCRYPTION_KEY_ID=1