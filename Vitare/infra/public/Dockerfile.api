# syntax=docker/dockerfile:1.7

FROM node:22-bookworm-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
WORKDIR /workspace

RUN apt-get update -y && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*
RUN corepack enable \
    && corepack prepare pnpm@11.9.0 --activate

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY apps/web-staff/package.json apps/web-staff/package.json
COPY packages/core-typings/package.json packages/core-typings/package.json
COPY packages/ui-components/package.json packages/ui-components/package.json
RUN pnpm install --frozen-lockfile

FROM deps AS build
COPY apps/api apps/api
RUN pnpm --filter @vitare/api exec prisma generate \
    && pnpm --filter @vitare/api build \
    && pnpm --filter @vitare/api deploy --legacy --prod /out/api

FROM build AS migrate
WORKDIR /workspace/apps/api
ENV NODE_ENV=production
ENV CI=true
# Re-install devDependencies to get prisma CLI for migrations
RUN pnpm install --filter @vitare/api --prod=false
CMD ["pnpm", "exec", "prisma", "migrate", "deploy"]

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production
ENV PORT=3000
WORKDIR /app

RUN useradd --system --create-home --uid 10001 vitare

COPY --from=build /out/api/ ./
COPY --from=build /workspace/apps/api/dist ./dist
COPY --from=build /workspace/apps/api/generated ./generated
COPY --from=build /workspace/apps/api/prisma ./prisma

USER vitare
EXPOSE 3000

CMD ["node", "dist/src/main.js"]
