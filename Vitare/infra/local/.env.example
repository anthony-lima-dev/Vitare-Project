# Copy to infra/local/.env.local and replace local values.
# Never commit .env.local.

HTTP_BIND=0.0.0.0
HTTPS_BIND=0.0.0.0
VITE_API_URL=/api/v1

POSTGRES_DB=vitare
POSTGRES_USER=vitare
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_LONG_LOCAL_ONLY_PASSWORD
DATABASE_URL=postgresql://vitare:CHANGE_ME_WITH_A_LONG_LOCAL_ONLY_PASSWORD@db:5432/vitare?schema=public
DIRECT_URL=postgresql://vitare:CHANGE_ME_WITH_A_LONG_LOCAL_ONLY_PASSWORD@db:5432/vitare?schema=public
POOLED_DATABASE_URL=postgresql://vitare:CHANGE_ME_WITH_A_LONG_LOCAL_ONLY_PASSWORD@db:5432/vitare?schema=public

APP_URL=https://YOUR_LAN_IP
CORS_ORIGIN=https://YOUR_LAN_IP

JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
STAFF_JWT_SECRET=CHANGE_ME_STAFF_SECRET
STAFF_JWT_EXPIRES_IN=8h

GOOGLE_CLIENT_ID=LOCAL_PLACEHOLDER
GOOGLE_CLIENT_SECRET=LOCAL_PLACEHOLDER
GOOGLE_CALLBACK_URL=https://YOUR_LAN_IP/api/v1/auth/google/callback

RESEND_API_KEY=LOCAL_PLACEHOLDER
MAIL_FROM="Vitare <onboarding@resend.dev>"
NODE_ENV=production
PORT=3000

# Redis interno (rede docker `data`, nunca publicada externamente)
REDIS_URL=redis://vitare-redis:6379
REDIS_KEY_PREFIX=vitare:local
STAFF_GEO_KEY=geo:staff
STAFF_GEO_TTL_SECONDS=300
EMERGENCY_IDEMPOTENCY_TTL_HOURS=24
EMERGENCY_SEARCH_RADIUS_M=5000

# Bootstrap da PRIMEIRA conta de staff (após o primeiro registro, novos
# profissionais só podem ser criados por um ADMINISTRATIVO autenticado).
STAFF_BOOTSTRAP_KEY=CHANGE_ME_BOOTSTRAP_KEY

# Custo bcrypt (10-15) — meça no ambiente antes de ajustar.
BCRYPT_SALT_ROUNDS=12

# Documentos jurídicos no onboarding (T-11) — versão vigente e hash do
# conteúdo publicado. Altere para forçar re-aceite em todos os fluxos.
TERMS_OF_USE_VERSION=v1.0.0
TERMS_OF_USE_CONTENT_HASH=sha256:terms-of-use-v1-0-0
PRIVACY_NOTICE_VERSION=v1.0.0
PRIVACY_NOTICE_CONTENT_HASH=sha256:privacy-notice-v1-0-0
